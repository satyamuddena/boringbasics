# ── Required ────────────────────────────────────────────────────────────────
# Admin login for /admin — the user is created automatically on first boot.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please

# Canonical URL used for SEO / sitemap / receipts (defaults to https://www.boringbasics.fit).
NEXT_PUBLIC_SITE_URL=https://www.boringbasics.fit

# ── Storage (optional) ──────────────────────────────────────────────────────
# Where the SQLite DB + uploaded images live. Defaults to ./data locally and
# /data inside Docker (mount a volume there!).
# DATA_DIR=./data

# ── Email (optional — enquiries/newsletters log to console until configured) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where enquiry notifications go. Defaults to the trainer email set in /admin.
LEAD_TO_EMAIL=

# ── Razorpay (consultation payment — the pay step degrades gracefully until set) ─
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Test-only: lets the booking flow skip payment when Razorpay isn't configured.
# Auto-on in local dev. Ignored in production; live deployments never allow bypass.
# ALLOW_PAYMENT_BYPASS=false

# Required in production: verifies Calendly scheduled-event URIs server-side
# before marking a paid booking as booked.
CALENDLY_ACCESS_TOKEN=

# ── Twilio WhatsApp (booking confirmations to trainer + customer) ───────────
# Two approved Content Templates are sent after a confirmed consultation.
# Recipients are not configured here: the trainer's number comes from /admin,
# the customer's from their booking. See docs/whatsapp-notifications.md.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A registered WhatsApp sender, e.g. whatsapp:+919999999999. The Twilio Sandbox
# cannot message customers — they would have to join it first.
TWILIO_WHATSAPP_FROM=
# Content SID (HX...) for the trainer alert. Body uses variables {{1}}–{{5}}.
TWILIO_WHATSAPP_CONTENT_SID=
# Content SID (HX...) for the customer confirmation. Body uses {{1}}–{{5}}.
TWILIO_WHATSAPP_CUSTOMER_CONTENT_SID=

# ── Web Push (the installable admin app) ────────────────────────────────────
# Notifications to the trainer's phone when a booking is paid or confirmed.
# Push degrades to a silent no-op until these are set, like Twilio/Razorpay.
# Generate ONE pair per environment and keep them stable — rotating the keys
# invalidates every device already subscribed:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Same value as VAPID_PUBLIC_KEY. Needed in the browser, hence NEXT_PUBLIC_.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Contact address push services use if a subscription misbehaves.
VAPID_SUBJECT=mailto:you@example.com

# ── Analytics (optional) ────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Instagram feed (optional — shows a static "follow" card without it) ─────
INSTAGRAM_ACCESS_TOKEN=
